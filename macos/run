#!/bin/bash
# Native launcher. Python 3 (stdlib) serves the desk and talks to court sites.
# The UI is WKWebView — no Chrome, no Node, no npm.
set -e
BASE="http://127.0.0.1:8765"
DIR="$(cd "$(dirname "$0")/../Resources" && pwd)"
PY="$(command -v python3 || echo /usr/bin/python3)"
BUNDLE_VER="$(sed -n 's/^VERSION *= *"\([^"]*\)".*/\1/p' "$DIR/server.py" | head -1)"

alert() {
  osascript -e "display alert \"Binder Builder\" message \"$1\"" >/dev/null 2>&1 || true
}

if ! "$PY" -c 'import http.server' >/dev/null 2>&1; then
  alert "Python 3 is needed. Open Terminal and run:  xcode-select --install   then reopen Binder Builder."
  exit 1
fi

if curl -s -o /dev/null --max-time 2 "$BASE/api/health"; then
  RUN_VER="$(curl -s --max-time 2 "$BASE/api/version" | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p')"
  if [ -z "$RUN_VER" ] || [ "$RUN_VER" != "$BUNDLE_VER" ]; then
    curl -s -o /dev/null --max-time 3 -X POST "$BASE/api/quit" || true
    for i in $(seq 1 25); do curl -s -o /dev/null --max-time 1 "$BASE/api/health" || break; sleep 0.3; done
  fi
fi

if ! curl -s -o /dev/null --max-time 1 "$BASE/api/health"; then
  "$PY" "$DIR/server.py" --serve >/dev/null 2>&1 &
  ok=0
  for i in $(seq 1 40); do
    if curl -s -o /dev/null --max-time 1 "$BASE/api/health"; then
      ok=1
      break
    fi
    sleep 0.2
  done
  if [ "$ok" != "1" ]; then
    alert "The desk did not start. Python 3 is required (xcode-select --install)."
    exit 1
  fi
fi

exec "$(dirname "$0")/webkit-window" "$BASE/"
